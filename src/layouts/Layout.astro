---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/paper.css';
import '../styles/knowledge.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Agalmic Research',
  description = 'Open, lineage-aware research on the economics of epistemic abundance, machine-assisted discovery, shifting bottlenecks, provenance and the institutions needed to turn cheap possibilities into warranted knowledge and useful realities.',
} = Astro.props;

const pageTitle = title === 'Agalmic Research' ? title : `${title} · Agalmic Research`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${base}/favicon.svg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1e8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
