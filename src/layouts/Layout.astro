---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ResearchObjectContext from '../components/ResearchObjectContext.astro';
import index from '../data/knowledgeIndex.json';
import '../styles/global.css';
import '../styles/paper.css';
import '../styles/knowledge.css';
import '../styles/discovery.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Agalmic Research',
  description = 'Open, lineage-aware research on the economics of epistemic abundance, machine-assisted discovery, shifting bottlenecks, provenance and the institutions needed to turn cheap possibilities into warranted knowledge and useful realities.',
} = Astro.props;

const pageTitle = title === 'Agalmic Research' ? title : `${title} · Agalmic Research`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${base}/favicon.svg`;
const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const researchKinds = new Set(['research-note', 'working-paper', 'draft']);
const contextMatches = index.objects.filter((item) => {
  if (!researchKinds.has(item.kind) || !item.href.startsWith('/') || item.href.startsWith('//')) return false;
  const href = item.href.replace(/[?#].*$/, '').replace(/\/+$/, '') || '/';
  return href === normalizedPath;
});
const contextItem = contextMatches.length === 1 ? contextMatches[0] : null;
const scholarlyJsonLd = contextItem ? {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  name: contextItem.title,
  headline: contextItem.title,
  description: contextItem.summary,
  url: canonical.toString(),
  dateModified: index.updated,
  keywords: contextItem.topics ?? [],
  creativeWorkStatus: contextItem.status,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Agalmic Research',
    url: 'https://agalmicresearch.org/',
  },
} : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1e8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Agalmic Research" href="/rss.xml" />
    <meta property="og:type" content={contextItem ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {scholarlyJsonLd && <script type="application/ld+json" set:html={JSON.stringify(scholarlyJsonLd)} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
      {contextItem && <ResearchObjectContext item={contextItem} />}
    </main>
    <Footer />
  </body>
</html>
