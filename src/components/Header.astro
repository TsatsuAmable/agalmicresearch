---
const path = Astro.url.pathname;
const links = [
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/principles', label: 'Principles' },
];
---
<header class="site-header">
  <nav class="shell nav" aria-label="Primary navigation">
    <a class="wordmark" href="/" aria-label="Agalmic Research home">
      <span class="wordmark-mark" aria-hidden="true"></span>
      <span>Agalmic Research</span>
    </a>
    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
      <a href="https://github.com/TsatsuAmable/agalmicresearch">GitHub ↗</a>
    </div>
  </nav>
</header>
