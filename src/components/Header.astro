---
const path = Astro.url.pathname.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (segment = '') => segment ? `${base}/${segment.replace(/^\//, '')}` : `${base}/`;
const links = [
  { href: route('explore'), label: 'Explore' },
  { href: route('practice'), label: 'Practice' },
  { href: route('publications'), label: 'Publications' },
  { href: route('frontier'), label: 'Frontier' },
  { href: route('about'), label: 'About' },
  { href: route('search'), label: 'Search' },
];
const isCurrent = (href) => {
  const normalized = href.replace(/\/$/, '');
  return path === normalized || (normalized && path.startsWith(`${normalized}/`));
};
---
<header class="site-header">
  <nav class="shell nav" aria-label="Primary navigation">
    <a class="wordmark" href={route()} aria-label="Agalmic Research home">
      <span class="wordmark-mark" aria-hidden="true"></span>
      <span>Agalmic Research</span>
    </a>
    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>
  </nav>
</header>
