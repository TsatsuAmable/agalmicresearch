---
const path = Astro.url.pathname.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (segment = '') => segment ? `${base}/${segment.replace(/^\//, '')}` : `${base}/`;
const links = [
  { href: route('research'), label: 'Research' },
  { href: route('publications'), label: 'Publications' },
  { href: route('drafts'), label: 'Drafts' },
  { href: route('provenance'), label: 'Provenance' },
  { href: route('principles'), label: 'Principles' },
];
---
<header class="site-header">
  <nav class="shell nav" aria-label="Primary navigation">
    <a class="wordmark" href={route()} aria-label="Agalmic Research home">
      <span class="wordmark-mark" aria-hidden="true"></span>
      <span>Agalmic Research</span>
    </a>
    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
      <a href="https://github.com/TsatsuAmable/agalmicresearch">GitHub ↗</a>
    </div>
  </nav>
</header>
