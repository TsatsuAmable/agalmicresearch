---
import KnowledgeContext from '../../packages/astro-agalmic/components/KnowledgeContext.astro';
import index from '../data/knowledgeIndex.json';
import handoffData from '../data/handoffs.json';
import history from '../data/knowledgeHistory.json';

const { item } = Astro.props;
---
<KnowledgeContext
  item={item}
  registry={index}
  handoffs={handoffData}
  history={history}
  routes={{
    lineage: '/lineage/',
    provenance: '/provenance/',
    frontier: '/frontier/',
    handoff: '/handoff/',
    history: '/history/',
  }}
  labels={{
    heading: 'Place this object in the research memory.',
    description: 'The page is one projection of a larger knowledge graph. These links are generated from the semantic registry rather than hand-maintained inside the article.',
    origins: 'Origins',
    related: 'Neighbours',
    next: 'Meaningful direction',
  }}
/>
