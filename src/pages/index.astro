---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const internal = (segment) => `${base}/${segment.replace(/^\//, '')}`;

const areas = [
  {
    n: '01',
    title: 'Attention in a world of abundant ideas',
    copy: 'If machines can generate thousands of plausible ideas, which ones deserve scarce human attention? We study how to direct limited evaluation effort without simply favoring whatever an AI system happens to produce.',
  },
  {
    n: '02',
    title: 'Making knowledge useful',
    copy: 'Having information is not the same as knowing how to use it. We study how knowledge moves from discovery to understanding, validation and action, and what keeps good ideas from becoming useful capabilities.',
  },
  {
    n: '03',
    title: 'Representation and discovery',
    copy: 'The way information is represented affects what people can see and understand. Nemosyne is an independent experimental system for exploring new ways to navigate and reason about complex datasets.',
  },
  {
    n: '04',
    title: 'Economics of abundance',
    copy: 'What happens when things that were once expensive become extremely cheap? We study how abundance changes value, moves bottlenecks and creates new forms of scarcity.',
  },
];
---
<Layout
  description="Agalmic Research studies how abundant knowledge and AI-generated capability can become practical progress, especially when attention, judgment, validation, trust and expertise remain scarce."
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">Agalmic Research</p>
      <h1>Making abundance useful.</h1>
      <p class="lede">
        Agalmic Research turns abundant knowledge and AI-generated capabilities into practical progress.
      </p>
      <p class="lede">
        We focus on the problems abundance does not solve: limited attention, judgment, validation, trust and expertise. Our work begins where ideas become cheap. We ask how to find the ideas worth pursuing, understand and test them, and turn them into tools and results people can use.
      </p>
      <div class="actions">
        <a class="button" href={internal('research')}>Explore the research</a>
        <a class="button secondary" href={internal('projects')}>See current projects</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell thesis">
      <p class="eyebrow">The problem</p>
      <blockquote>Abundance does not remove scarcity. It moves it.</blockquote>
      <p>AI can now generate ideas, information and analysis at unprecedented scale. Agalmic Research studies the new bottlenecks created by that abundance and develops ways to overcome them, helping people evaluate ideas more effectively, learn faster and build what matters.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="section-number">Current questions</span>
        <div class="section-copy">
          <h2>What we are working on.</h2>
          <p>Four connected questions sit at the centre of the research.</p>
        </div>
      </div>
      <div class="grid">
        {areas.map((item) => (
          <article class="card">
            <span class="card-kicker">{item.n}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">The underlying idea</p>
        <h2>Make valuable things more abundant.</h2>
      </div>
      <div class="prose">
        <p class="large">Agalmics is the study and practice of making valuable things more abundant.</p>
        <p>That does not mean pretending limits disappear. It means asking a practical question:</p>
        <div class="callout"><p><strong>Which constraint can we remove next, and what becomes possible when we do?</strong></p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">Research and publications</p>
        <h2>Ideas should leave evidence behind.</h2>
      </div>
      <div class="prose">
        <p>Some ideas become papers. Others become software, experiments, datasets or tools. Some turn out to be wrong.</p>
        <p class="large">Each outcome can expand what we know.</p>
        <div class="actions">
          <a class="button" href={internal('research')}>Explore the research</a>
          <a class="button secondary" href={internal('projects')}>See current projects</a>
          <a class="button secondary" href={internal('publications')}>Read publications</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell thesis">
      <p class="eyebrow">Why this exists</p>
      <blockquote>The goal is not to produce more ideas. It is to increase our ability to reach worthwhile futures.</blockquote>
    </div>
  </section>
</Layout>
