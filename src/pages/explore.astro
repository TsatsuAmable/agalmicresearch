---
import Layout from '../layouts/Layout.astro';
import KnowledgeExplorer from '../components/KnowledgeExplorer.astro';
import index from '../data/knowledgeIndex.json';

const activeDirections = index.objects.filter((item) => item.layer === 'direction' && item.commitment === 'active');
---
<Layout
  title="Explore"
  description="Explore Agalmic Research through its current questions, projects, publications and deeper research record."
>
  <header class="page-head">
    <div class="shell">
      <p class="eyebrow">Explore</p>
      <h1>Start with the questions. Go deeper when you need to.</h1>
      <p class="lede">Agalmic Research contains papers, experiments, notes, methods and supporting records. You do not need to understand all of that machinery to find the useful parts.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="section-number">Current work</span>
        <div class="section-copy">
          <h2>What is receiving attention now.</h2>
          <p>These are the few directions currently being tested or developed.</p>
        </div>
      </div>
      <div class="direction-strip">
        {activeDirections.map((item) => (
          <article class="direction-card">
            <p class="eyebrow">{item.status}</p>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <p class="direction-next"><strong>Next:</strong> {item.direction}</p>
            <p><a href={item.href}>Open →</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="section-number">Choose a path</span>
        <div class="section-copy">
          <h2>Find the level of detail you want.</h2>
        </div>
      </div>
      <div class="grid">
        <article class="card">
          <span class="card-kicker">Research</span>
          <h3>The questions</h3>
          <p>See the main problems being studied and why they matter.</p>
          <p><a href="/research/">Explore research →</a></p>
        </article>
        <article class="card">
          <span class="card-kicker">Projects</span>
          <h3>The work in progress</h3>
          <p>See what is active, what is related, and where each project currently stands.</p>
          <p><a href="/projects/">See projects →</a></p>
        </article>
        <article class="card">
          <span class="card-kicker">Results</span>
          <h3>What changed</h3>
          <p>See findings, negative results, corrections and ideas that became narrower after testing.</p>
          <p><a href="/results/">See results →</a></p>
        </article>
        <article class="card">
          <span class="card-kicker">Publications</span>
          <h3>What is ready to read</h3>
          <p>See work that has reached a durable public form.</p>
          <p><a href="/publications/">Read publications →</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="knowledge-explorer">
    <div class="shell">
      <div class="section-head">
        <span class="section-number">Full record</span>
        <div class="section-copy">
          <h2>Browse everything.</h2>
          <p>The full research record includes notes, drafts, evidence, methods and earlier directions. Use the explorer when you want the underlying detail rather than the short public view.</p>
        </div>
      </div>
      <KnowledgeExplorer items={index.objects} />
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">Supporting records</p>
        <h2>Methods and history stay available.</h2>
      </div>
      <div class="prose">
        <p>For scrutiny, reuse and reproducibility, the site keeps its methods, prior-art work and provenance records public. These support the research without needing to dominate the main navigation.</p>
        <div class="actions">
          <a class="button secondary" href="/method/">Methods</a>
          <a class="button secondary" href="/lineage/">Prior work and lineage</a>
          <a class="button secondary" href="/provenance/">Provenance</a>
          <a class="button secondary" href="/knowledge-index.json">Knowledge index JSON</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
