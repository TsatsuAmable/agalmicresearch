---
import Layout from '../layouts/Layout.astro';

const tracks = [
  ['Epistemic Stewardship & Handoff', 'The governance of claims and contributions when machine cognition can produce artefacts whose sophistication exceeds the human initiator’s present capacity to defend them.', 'How should defensibility be demonstrated? How should contribution and authority be separated? How can low-authority ideas be routed toward capable stewards without erasing their originators?'],
  ['Epistemic Uptake', 'The capacity of institutions to notice, route, evaluate, validate, integrate and realise candidate knowledge when idea generation becomes cheap.', 'What becomes scarce when ideas are abundant? How should expert attention be allocated? How do we prevent credential capture, idea appropriation and filter monopoly?'],
  ['Agalmic Economics', 'A general theory of economic organisation when important goods become non-rival or extremely cheap to reproduce.', 'Where does scarcity migrate? How should value be measured? Which classical assumptions survive?'],
  ['Epistemic Economics', 'The allocation of scarce attention, validation, trust, institutional bandwidth and physical capability in a world of cheap candidate knowledge.', 'What is the price of verification? How do we rank claims? What replaces generation as the bottleneck?'],
  ['Innovation as Search', 'A formal account of innovation as exploration and exploitation of adjacent possibles, increasingly performed by human-model systems.', 'How should search be directed? How is novelty distinguished from noise? Who chooses which branch receives resources?'],
  ['Attention & Selection', 'The economics and information theory of choosing among an expanding set of plausible ideas, models, artefacts and interventions.', 'How do filters avoid becoming the new monopolies? Who curates the curators? How should uncertainty and stability affect ranking?'],
  ['Representation as Discovery', 'Methods for finding representations that preserve meaningful information while reducing cognitive, computational or physical cost.', 'What does “meaning-preserving” mean formally? Can representation choice be treated as a constraint-solving problem?'],
  ['Institutions, IP & Rents', 'Property, incentives and institutional design when invention and disclosure can happen at machine speed.', 'When does defensive publication dominate patenting? When is temporary exclusivity genuinely needed to finance realisation?'],
];
---
<Layout title="Research" description="The Agalmic Research programme: epistemic stewardship, handoff, uptake, economics, innovation, attention, representation and governance under abundance.">
  <header class="page-head">
    <div class="shell">
      <p class="eyebrow">Research</p>
      <h1>A map of the questions.</h1>
      <p class="lede">The programme starts from linked disturbances: possible answers are becoming cheap to produce, human understanding does not automatically scale with their sophistication, and society still needs institutions capable of finding and stewarding what is worth keeping.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="index-list">
        {tracks.map(([title, copy, questions], i) => (
          <article class="index-item">
            <span class="index-meta">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{title}</h3>
              <p class="muted">{copy}</p>
              <p><strong>Questions:</strong> {questions}</p>
            </div>
            <span class="index-status">active programme</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">Method</p>
        <h2>Ideas earn their keep by becoming testable, defensible and transferable.</h2>
      </div>
      <div class="prose">
        <p>Each track should move through a clear conceptual claim, formalisation where useful, empirical or software demonstration where possible, and an explicit account of epistemic status and contribution provenance.</p>
        <p class="muted">Formalism is not decoration, and machine-assisted polish is not evidence of mastery. The aim is to expose assumptions, derive consequences, invite adversarial criticism, distinguish what is understood from what is merely generated, and route promising work toward the expertise it still lacks.</p>
      </div>
    </div>
  </section>
</Layout>
