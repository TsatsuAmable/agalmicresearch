---
import Layout from '../layouts/Layout.astro';
import projectsData from '../data/projects.json';

const active = projectsData.projects.filter((project) => project.state === 'active');
const related = projectsData.projects.filter((project) => project.state === 'related');
const supporting = projectsData.projects.filter((project) => ['supporting', 'absorbed'].includes(project.state));
---
<Layout
  title="Projects"
  description="Current Agalmic Research projects, related experiments and supporting tools."
>
  <header class="page-head">
    <div class="shell">
      <p class="eyebrow">Projects</p>
      <h1>What is being worked on now.</h1>
      <p class="lede">This page separates the research we are actively pursuing from related experiments and the tools that support the work.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="section-number">Active</span>
        <div class="section-copy">
          <h2>Current Agalmic Research projects.</h2>
          <p>These are the projects receiving substantial attention now.</p>
        </div>
      </div>
      <div class="index-list">
        {active.map((project, index) => (
          <article class="index-item">
            <span class="index-meta">A{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <p><strong>Where it stands:</strong> {project.current_result}</p>
              <p><strong>Next question:</strong> {project.next}</p>
              <p>
                {project.links.map((link, linkIndex) => (
                  <>
                    {linkIndex > 0 && ' · '}
                    <a href={link.href}>{link.label} ↗</a>
                  </>
                ))}
              </p>
            </div>
            <span class="index-status">active</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="section-number">Related</span>
        <div class="section-copy">
          <h2>Independent projects that help answer specific questions.</h2>
          <p>These projects can provide experiments or evidence without becoming part of Agalmic Research itself.</p>
        </div>
      </div>
      <div class="index-list">
        {related.map((project, index) => (
          <article class="index-item">
            <span class="index-meta">R{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <p><strong>How it relates:</strong> {project.current_result}</p>
              <p><strong>Next:</strong> {project.next}</p>
              <p>
                {project.links.map((link, linkIndex) => (
                  <>
                    {linkIndex > 0 && ' · '}
                    <a href={link.href}>{link.label} ↗</a>
                  </>
                ))}
              </p>
            </div>
            <span class="index-status">related</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="section-number">Supporting</span>
        <div class="section-copy">
          <h2>Tools and earlier work.</h2>
          <p>These remain useful, but they are not presented as research programmes in their own right.</p>
        </div>
      </div>
      <div class="index-list">
        {supporting.map((project, index) => (
          <article class="index-item">
            <span class="index-meta">S{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <p><strong>Current state:</strong> {project.current_result}</p>
              <p><strong>Next:</strong> {project.next}</p>
              <p>
                {project.links.map((link, linkIndex) => (
                  <>
                    {linkIndex > 0 && ' · '}
                    <a href={link.href}>{link.label} ↗</a>
                  </>
                ))}
              </p>
            </div>
            <span class="index-status">{project.state}</span>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
