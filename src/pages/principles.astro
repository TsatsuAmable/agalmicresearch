---
import Layout from '../layouts/Layout.astro';

const principles = [
  ['Keep epistemic authority within defensibility', 'Machine cognition may expand what can be produced faster than it expands what the human curator can understand. Publish the work, but do not imply more mastery, certainty or authority than can be defended.'],
  ['Open by default', 'Knowledge compounds when others can inspect, reuse and challenge it. Closed work should require a reason, not openness.'],
  ['Publish to establish provenance', 'Early public disclosure creates a timestamped intellectual record and makes ideas available for criticism and reuse. Publication records a claim; it does not certify it.'],
  ['Version instead of waiting for finality', 'Research is allowed to improve in public. Every release should state what is claim, evidence, conjecture, epistemic status and revision.'],
  ['Treat attention as a scarce resource', 'Abundant output can still impoverish a system if it consumes more human attention than the value it creates.'],
  ['Prefer selection quality over generation volume', 'The objective is not to maximise the number of ideas. It is to improve the rate at which valuable possibilities are recognised and realised.'],
  ['Build demonstrations, not only arguments', 'Software, models and reproducible analyses are part of the research programme because they force conceptual claims into contact with constraints.'],
  ['Use exclusivity only when it enables realisation', 'Patenting is an instrument, not a default. It is justified only when temporary exclusivity is plausibly necessary to finance, coordinate or protect the difficult work of turning an idea into a socially useful reality.'],
  ['Keep institutions provisional', 'Agalmic Research should be judged by the quality, openness and durability of its work, not by whether it prematurely imitates the bureaucracy of an established institute.'],
];
---
<Layout title="Principles" description="Operating principles for Agalmic Research: defensible stewardship, open publication, provenance, versioning, attention discipline and selective use of intellectual property.">
  <header class="page-head">
    <div class="shell">
      <p class="eyebrow">Principles</p>
      <h1>The institution should embody the thesis.</h1>
      <p class="lede">If the research argues that cognition and knowledge production can become abundant, the research practice itself must make both its work and the limits of its understanding visible.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell thesis">
      <p class="eyebrow">Principle of Defensible Stewardship</p>
      <blockquote>Epistemic authority should not exceed defensibility.</blockquote>
      <p>Cognition may be delegated. Responsibility cannot be. Where human comprehension is limited, claims should carry proportionately stronger provenance, verification, reproducibility, adversarial scrutiny and disclosure.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="grid">
        {principles.map(([title, copy], i) => (
          <article class="card">
            <span class="card-kicker">{String(i + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div>
        <p class="eyebrow">A useful default</p>
        <h2>Publish early. Claim carefully. Keep improving.</h2>
      </div>
      <div class="prose">
        <p class="large">Open publication is a research method, not a declaration of authority.</p>
        <p class="muted">The default is to expose ideas to criticism and establish provenance while stating their epistemic status honestly. Technical machinery receives an additional publication review where disclosure could destroy a legitimate path to difficult real-world implementation or intellectual-property protection.</p>
      </div>
    </div>
  </section>
</Layout>
