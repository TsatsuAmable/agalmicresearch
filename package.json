{
  "name": "shaggy-singularity",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:knowledge": "node scripts/validate-knowledge-index.mjs",
    "test:astro-agalmic": "node --test packages/astro-agalmic/test/*.test.mjs",
    "pack:astro-agalmic": "npm pack ./packages/astro-agalmic --dry-run",
    "build": "npm run check:knowledge && npm run test:astro-agalmic && npm run pack:astro-agalmic && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
