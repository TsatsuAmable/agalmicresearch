{
  "name": "agalmic-research",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:knowledge": "node scripts/validate-knowledge-index.mjs",
    "test:astro-agalmic": "node --test packages/astro-agalmic/test/*.test.mjs",
    "eval:agalmic-kernel": "node scripts/evaluate-agalmic-kernel.mjs",
    "pack:astro-agalmic": "npm pack ./packages/astro-agalmic --dry-run",
    "build": "npm run check:knowledge && npm run test:astro-agalmic && npm run test:kernel-consequence && npm run test:kernel-pair-planner && npm run pack:astro-agalmic && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "audit:throughput": "node scripts/frontier-throughput.mjs",
    "prepare:kernel-eval": "node scripts/prepare-kernel-eval-pairs.mjs",
    "summarize:kernel-consequences": "node scripts/summarize-kernel-consequences.mjs",
    "record:kernel-consequence": "node scripts/record-kernel-consequence.mjs",
    "test:kernel-consequence": "node scripts/test-kernel-consequence.mjs",
    "plan:kernel-pair": "node scripts/plan-kernel-pair.mjs",
    "test:kernel-pair-planner": "node scripts/test-kernel-pair-planner.mjs"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
