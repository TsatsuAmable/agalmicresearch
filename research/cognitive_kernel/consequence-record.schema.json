{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agalmic Cognitive Kernel Consequence Record",
  "type": "object",
  "required": [
    "record_id",
    "pair_id",
    "task_id",
    "task_family",
    "generator_family",
    "condition",
    "started_at",
    "completed_at",
    "human_minutes",
    "verified_completion",
    "rework_count",
    "boundary_violations",
    "downstream_failures",
    "verification_method",
    "evidence"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_family": {
      "enum": [
        "research-synthesis",
        "repository-change",
        "benchmark-or-analysis",
        "publication-or-documentation"
      ]
    },
    "generator_family": {
      "type": "string",
      "minLength": 1
    },
    "generator_version": {
      "type": "string"
    },
    "condition": {
      "enum": [
        "control",
        "kernel"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "human_minutes": {
      "type": "number",
      "minimum": 0
    },
    "verified_completion": {
      "type": "boolean"
    },
    "rework_count": {
      "type": "integer",
      "minimum": 0
    },
    "boundary_violations": {
      "type": "integer",
      "minimum": 0
    },
    "downstream_failures": {
      "type": "integer",
      "minimum": 0
    },
    "verification_method": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
