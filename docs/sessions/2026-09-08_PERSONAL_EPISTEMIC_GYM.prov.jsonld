      "@id": "ar:entity/personal-epistemic-gym",
      "@type": ["prov:Entity", "ar:ResearchMethod", "ar:CapabilityTrainingProtocol"],
      "schema:name": "Personal Epistemic Gym",
      "schema:description": "A capability-forming human-AI scholarly practice using live epistemic artefacts, pre-commitment, retrieval, adversarial interrogation, source verification, viva-style defence, scaffold fading and delayed transfer to expand durable human scholarly capability.",
      "prov:wasDerivedFrom": [
        {"@id": "ar:entity/the-critical-scholar"},
        {"@id": "ar:entity/epistemic-artefact-intake"},
        {"@id": "ar:entity/authorial-capacity-constraint"}
      ],
