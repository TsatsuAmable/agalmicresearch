      "ar:noveltyStatus": "synthesis/application; novelty unassessed",
      "ar:branchState": "option-high-value-candidate",
      "ar:reversalCondition": "Narrow, redesign or retire if delayed unaided transfer, calibration or defensibility do not improve relative to ordinary research practice plus unrestricted AI use."
    },
    {
      "@id": "ar:decision/profile-not-score",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Use a non-scalar scholarly capability profile",
      "ar:decisionRationale": "A single scholar score would hide distinct capabilities and could be mistaken for global authority.",
      "ar:reversible": true
    },
    {
      "@id": "ar:decision/separate-scholarliness-authority",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Keep scholarliness separate from epistemic authority",
      "ar:decisionRationale": "Training can increase the capacity needed to earn authority, but authority remains claim-sensitive and warrant-dependent.",
      "ar:reversible": false
    },
    {
      "@id": "ar:decision/real-artefacts",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Use real research artefacts as primary training material",
      "ar:decisionRationale": "Capability formation should compound with live scholarship rather than become a separate attention-consuming ritual.",
      "ar:reversible": true
    },
    {
      "@id": "ar:decision/delayed-transfer",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Require delayed or novel transfer evidence for durable capability claims",
      "ar:decisionRationale": "AI-assisted performance may improve without durable human learning or accurate metacognition.",
      "ar:reversible": true
    }
