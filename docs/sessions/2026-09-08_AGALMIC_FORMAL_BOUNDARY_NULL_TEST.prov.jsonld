      "schema:datePublished": "2016",
      "schema:identifier": "doi:10.1093/reep/rev017",
      "ar:influence": "Antecedent for induced demand offsetting efficiency-driven scarcity relief."
    },
    {
      "@id": "ar:source/original-agalmics",
      "@type": ["prov:Entity", "ar:PriorArt"],
      "schema:name": "The Marginalization of Scarcity",
      "schema:author": "Robert Levin",
      "schema:datePublished": "1999-04-04",
      "ar:influence": "Defines agalmics as the study and practice of production and allocation of non-scarce goods and notes that such goods may be produced from scarce inputs."
    }
