      "@type": ["prov:Entity", "schema:ScholarlyArticle", "ar:PriorArt"],
      "schema:name": "Endogenous Technological Change",
      "schema:author": "Paul M. Romer",
      "schema:datePublished": "1990",
      "schema:identifier": "doi:10.1086/261725",
      "ar:influence": "Shows that modern economics explicitly models intentional technological change and non-rival, partially excludable knowledge."
    },
    {
      "@id": "ar:source/acemoglu-2002",
      "@type": ["prov:Entity", "schema:ScholarlyArticle", "ar:PriorArt"],
      "schema:name": "Directed Technical Change",
      "schema:author": "Daron Acemoglu",
      "schema:datePublished": "2002",
      "schema:identifier": "doi:10.1111/1467-937X.00226",
      "ar:influence": "Shows innovation direction responding to relative scarcity, prices, market size and substitution."
    },
    {
      "@id": "ar:source/jones-2011",
      "@type": ["prov:Entity", "schema:ScholarlyArticle", "ar:PriorArt"],
      "schema:name": "Intermediate Goods and Weak Links in the Theory of Economic Development",
