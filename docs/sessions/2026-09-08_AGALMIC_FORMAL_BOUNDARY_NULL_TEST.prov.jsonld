    {
      "@id": "ar:decision/reject-scalar-abundance-index",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Reject a scalar Agalmic Abundance Index at current evidence level",
      "ar:decisionRationale": "Scarcity dimensions such as marginal cost, supply elasticity, rivalry, excludability, congestion, complement dependence, attention burden, externalities and concentration are heterogeneous and cannot be defensibly collapsed with arbitrary weights.",
      "ar:reversible": true,
      "ar:reversalCondition": "A specific empirical application supplies validated commensuration and demonstrates predictive or diagnostic value."
    },
    {
      "@id": "ar:entity/scarcity-transition-profile",
      "@type": ["prov:Entity", "ar:ResearchInstrumentCandidate"],
      "schema:name": "Non-scalar scarcity transition profile",
      "schema:description": "Candidate comparative record of marginal cost, scalable supply, rivalry, excludability/access friction, congestion, scarce-complement dependence, attention/verification burden, externalized burden and concentration/control for a capability over time.",
      "ar:epistemicStatus": "exploratory",
      "ar:noveltyStatus": "candidate synthesis / measurement operationalization; novelty unassessed",
      "ar:branchState": "explored-active",
      "ar:reversalCondition": "Retire if mature existing frameworks already perform the same cross-domain function or empirical pilots add no analytical value."
    },
    {
      "@id": "ar:decision/null-test-verdict",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Do not claim new Agalmic theory or predictive law",
      "ar:decisionRationale": "Targeted formalization and lineage comparison found standard representations and close antecedents for constraint displacement, network propagation, non-rivality, scarce complements and rebound effects.",
      "ar:reversible": true,
      "ar:reversalCondition": "A lineage-positioned formal result or empirical regularity demonstrates explanatory or predictive content unavailable from the compared antecedent frameworks."
    },
