      "@id": "ar:decision/human-successor-scarcity-endogenous",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Treat at least some human judgment and verification capacity as endogenous",
      "ar:decisionRationale": "Education, deliberate practice and AI-mediated training can change effective evaluator capacity, so it should not automatically be modeled as a fixed successor bottleneck.",
      "ar:reversible": true,
      "ar:reversalCondition": "Revise if domain-specific evidence shows the relevant capacity is effectively fixed over the decision horizon."
