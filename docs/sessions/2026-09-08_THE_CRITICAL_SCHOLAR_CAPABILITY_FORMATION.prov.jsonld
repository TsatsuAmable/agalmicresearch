      "schema:name": "Preserve The Critical Scholar as a testable programme artefact",
      "ar:decisionRationale": "The supplied framework contains a coherent curriculum, assessment architecture and explicit transfer criterion rather than only prompting advice.",
      "ar:reversible": true,
      "ar:reversalCondition": "Narrow to ordinary AI-literacy pedagogy if lineage review shows no distinct contribution and empirical testing shows no durable transfer benefit."
    },
