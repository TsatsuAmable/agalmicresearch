    {
      "@id": "ar:entity/boundary-review-verdict",
      "@type": ["prov:Entity", "ar:ResearchFinding"],
      "schema:name": "Agalmic Research is not presently supported as a new economic theory",
      "schema:description": "The strongest surviving status is a problem-oriented interdisciplinary programme focused on transitions in the economic character of scarcity and on successor scarcity across connected systems.",
      "ar:epistemicStatus": "exploratory but lineage-constrained",
      "ar:noveltyStatus": "synthesis / operationalization candidate; novelty unassessed",
      "ar:handoffNeeded": true
    },
    {
      "@id": "ar:entity/candidate-programme-boundary",
      "@type": ["prov:Entity", "ar:ConceptualModel"],
      "schema:name": "Scarcity-character transition as candidate Agalmic unit of inquiry",
      "schema:description": "Study transitions in which a good, input or capability moves from allocation-dominated scarcity toward highly scalable, low-marginal-cost, low-rivalry or otherwise functionally abundant availability, while tracing successor constraints, rents, risks, externalities and access problems.",
      "prov:wasDerivedFrom": {"@id": "ar:entity/boundary-review-verdict"},
      "ar:epistemicStatus": "exploratory synthesis",
      "ar:noveltyStatus": "unassessed",
      "ar:branchState": "explored-selected",
      "ar:reversalCondition": "Retire or fold into an established field if formal and empirical work yields no distinct explanatory, predictive or measurement value beyond antecedent literatures."
    },
    {
      "@id": "ar:decision/remove-worthwhile-futures-field-core",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Recommend removing worthwhile futures from the analytical field definition",
      "ar:decisionRationale": "The phrase embeds normative social direction into the field definition and weakens the boundary from mission-oriented and industrial policy. It may remain as an institutional ethical criterion.",
      "ar:reversible": true,
      "ar:reversalCondition": "A rigorous non-planner interpretation proves necessary and survives political-economy review."
    },
    {
      "@id": "ar:decision/reject-fixed-scarcity-economics-contrast",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Reject fixed-scarcity economics versus constraint-transforming Agalmics contrast",
      "ar:decisionRationale": "Endogenous growth, directed technical change and GPT/bottleneck research already model changing productive constraints and non-rival knowledge.",
      "ar:reversible": false
    },
    {
      "@id": "ar:decision/programme-not-theory",
      "@type": ["prov:Entity", "ar:Decision"],
      "schema:name": "Provisionally classify Agalmic Research as an interdisciplinary research programme rather than a new economic theory",
      "ar:decisionRationale": "Strong prior art covers the component mechanisms while a narrower cross-domain research object may still provide useful synthesis and measurement.",
      "ar:reversible": true,
      "ar:reversalCondition": "Distinct formal theory, measurements and empirical predictions are independently validated."
    },
